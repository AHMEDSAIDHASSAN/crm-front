# --- Load order (see src/main.ts) ---
# 1) .env                    — NODE_ENV, secrets; in development this file is loaded again last and wins.
# 2) .env.development        — dev-only defaults (PORT, CORS_ORIGINS), not secrets.
# 3) .env (again, dev only)   — overrides step 2 so DATABASE_URL / JWT in `.env` are used.
# 4) .env.development.local  — optional; gitignored; highest priority (e.g. alternate DB URL).
#    Template: `.env.development.local.example` if you use it.

# Example .env (no DATABASE_URL if you use .env.development for DB):
NODE_ENV=development
PORT=2003
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Example .env.development (dev database — this file overrides .env for same keys):
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/crm"
# Password special chars must be URL-encoded in the URL (e.g. @ → %40).

# Local Docker only (repo root: docker compose up -d):
# DATABASE_URL="mysql://root:realstate_local@127.0.0.1:3306/crm"

# Create tables on an empty DB: `npm run db:push` (backend), or `mysql ... crm < prisma/baseline_from_schema.sql`.
# `npm run db:migrate` is for incremental migrations only (expects existing baseline); empty DBs use db:push.

# WhatsApp Business API (Meta Cloud API) — for lead assignment notifications to sales reps.
# Get from: Meta for Developers → WhatsApp → API Setup
# Leave empty to disable WhatsApp notifications.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
